---
// ABOUTME: Small nav between the /home-lab layout prototypes.
interface Props {
  current: "tiers" | "collage" | "garden" | "rows" | "constellation" | "spotlight";
}
const { current } = Astro.props;
const options = [
  ["spotlight", "D2 · spotlight (newest)"],
  ["constellation", "E · constellation"],
  ["rows", "D · rows"],
  ["tiers", "A · tiers"],
  ["collage", "B · collage"],
  ["garden", "C · garden"],
];
---

<p class="labSwitcher">
  layout prototypes:{" "}
  {
    options.map(([slug, label], idx) => (
      <>
        {idx > 0 && " · "}
        <a href={`/home-lab/${slug}`} class={slug === current ? "current" : ""}>
          {label}
        </a>
      </>
    ))
  }{" "}
  · <a href="/">current home</a>
</p>

---
import Signature from "./Signature";
import Trinkets from "./Trinkets.astro";
---

<footer>
  <div class="footerContent">
    <div class="textContent">
      <!-- TODO: make this an input -->
      <p>
        If you enjoyed your stay, <a href="https://spencerchang.substack.com"
          >sign your email up</a
        > to receive updates from my explorations.
      </p>
      <p>
        My work is made possible, in large part, by <a href="/support"
          >support from community members</a
        >.
      </p>
      <p class="footer-colophon"><a href="/colophon">colophon</a></p>
      <Signature client:only="react" hideOnHome />
    </div>
    <Trinkets />
  </div>
  <!-- TODO: this is a good opportunity to add some sort of graphical or interactive thing.. for people who scroll all the way to the bottom -->
</footer>

<style>
  .footer-colophon {
    font-family: var(--sp-font-mono);
    font-size: var(--sp-type-meta-size);
  }
</style>

---
import EmailEmbed from "../../components/EmailEmbed.astro";
import SocialMediaLinks from "../../components/SocialMediaLinks";
import DetailLayout from "../../layouts/DetailLayout.astro";
import PostsList from '../../components/PostsList.astro';
import NewsletterRedirect from "../../components/NewsletterRedirect";

const LayoutProps = {
    title: "(newsletter)",
    description: "follow me...",
    date: "2024-04-11",
    image: "/newsletter.png",
    emojis: [],
  titleClass: 'uniform'
}

export interface NewsletterRSSItem {
  title:       string;
  pubDate:     Date;
  link:        string;
  guid:        string;
  thumbnail:   string;
  description: string;
  content:     string;
  enclosure:   {
    link: string; // this is the thumbnail image
  };
  categories:  any[];
}

const newsletterFeedUrl = 'https://spencerchang.substack.com/feed';

async function fetchWithTimeout(url: string, ms = 15000) {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), ms);
  try {
    return await fetch(url, { signal: controller.signal });
  } finally {
    clearTimeout(timer);
  }
}

// rss2json sometimes answers with an HTML error page instead of JSON, so check
// the response before parsing and retry a couple of times.
async function fetchFromRss2Json(): Promise<NewsletterRSSItem[]> {
  let lastError: unknown;
  for (let attempt = 0; attempt < 3; attempt++) {
    try {
      const res = await fetchWithTimeout(`https://api.rss2json.com/v1/api.json?rss_url=${newsletterFeedUrl}`);
      const text = await res.text();
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = JSON.parse(text);
      if (data.status !== 'ok' || !Array.isArray(data.items)) {
        throw new Error(data.message || 'unexpected response');
      }
      return data.items;
    } catch (e) {
      lastError = e;
      await new Promise(r => setTimeout(r, 2000 * (attempt + 1)));
    }
  }
  throw lastError;
}

function decodeEntities(s: string) {
  return s
    .replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'").replace(/&amp;/g, '&');
}

function readTag(xml: string, tag: string) {
  const match = xml.match(new RegExp(`<${tag}[^>]*>([\\s\\S]*?)</${tag}>`));
  if (!match) return '';
  const value = match[1].trim();
  const cdata = value.match(/^<!\[CDATA\[([\s\S]*)\]\]>$/);
  return cdata ? cdata[1] : decodeEntities(value);
}

// Fallback: read the Substack RSS feed directly.
async function fetchFromSubstack(): Promise<NewsletterRSSItem[]> {
  const res = await fetchWithTimeout(newsletterFeedUrl);
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  const xml = await res.text();
  const items = xml.match(/<item>[\s\S]*?<\/item>/g) || [];
  return items.map(item => ({
    title: readTag(item, 'title'),
    pubDate: new Date(readTag(item, 'pubDate')),
    link: readTag(item, 'link'),
    guid: readTag(item, 'guid'),
    thumbnail: '',
    description: readTag(item, 'description'),
    content: '',
    enclosure: { link: item.match(/<enclosure[^>]*url="([^"]+)"/)?.[1] ?? '' },
    categories: [],
  }));
}

let posts: NewsletterRSSItem[] = [];
try {
  posts = await fetchFromRss2Json();
} catch (e) {
  console.warn(`[newsletter] rss2json failed (${e}), reading Substack feed directly`);
  try {
    posts = await fetchFromSubstack();
  } catch (e2) {
    console.warn(`[newsletter] Substack feed failed too (${e2}), rendering without posts`);
  }
}

const transformedPosts = posts?.map(post => ({
  slug: post.guid,
  data: {
    title: post.title,
    description: post.description,
    pubDate: new Date(post.pubDate),
    heroImage: post.enclosure?.link,
    externalLink: post.link,
  }
})) || [];

---

<DetailLayout {...LayoutProps}>
    <div class="listDescription textContent" style={{gap: ".5em"}}>
        <p>Subscribe to my newsletter for updates. No spam—I promise—only the things I find interesting.</p>
        <EmailEmbed/>
        <SocialMediaLinks client:only="react"/>
    </div>
    <div>
      <PostsList posts={transformedPosts} />
    </div>
    <NewsletterRedirect  client:only="react" />
</DetailLayout>

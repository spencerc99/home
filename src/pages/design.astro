---
// ABOUTME: Internal design board for comparing UI options (currently the gallery lightbox).
// ABOUTME: Unlinked from the nav and left out of the sitemap.
import BaseLayout from "../layouts/BaseLayout.astro";
import { LightboxDesignBoard } from "../components/LightboxDesignBoard";
---

<BaseLayout title="Design" description="Design options in progress">
  <div class="one-column">
    <div class="textContent design-page">
      <header>
        <h1 class="uniform">(design)</h1>
        <p><i>options in progress, not linked from anywhere.</i></p>
      </header>
      <h2 class="design-topic">gallery lightbox</h2>
      <LightboxDesignBoard client:only="react" />
    </div>
  </div>
</BaseLayout>

<style lang="scss" is:global>
  .design-page {
    .design-topic {
      font-family: var(--sp-font-mono);
      font-size: var(--sp-type-meta-size);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--sp-color-text-subtle);
      margin-top: var(--sp-space-8);
    }
  }

  .ldb-intro {
    display: flex;
    gap: var(--sp-space-4);
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    p {
      margin: 0;
      max-width: var(--sp-measure);
    }
  }

  .ldb-toggle {
    display: inline-flex;
    padding: 3px;
    border-radius: var(--sp-radius-pill);
    background: var(--color-neutral-background);
    border: 1px solid var(--border-color);
    button {
      all: unset;
      cursor: pointer;
      font-family: var(--sp-font-mono);
      font-size: var(--sp-type-meta-size);
      padding: 0.25em 0.9em;
      border-radius: var(--sp-radius-pill);
      color: var(--sp-color-text-subtle);
      &[aria-pressed="true"] {
        background: var(--sp-color-accent);
        color: #282828;
      }
      &:focus-visible {
        outline: 2px solid var(--sp-color-accent);
        outline-offset: 2px;
      }
    }
  }

  .ldb-variant {
    margin-top: var(--sp-space-12);
    h2 {
      font-size: var(--sp-type-heading-size);
      margin: 0;
    }
  }
  .ldb-letter {
    font-family: var(--sp-font-mono);
    color: var(--sp-color-accent);
  }
  .ldb-blurb {
    color: var(--sp-color-text-subtle);
    max-width: var(--sp-measure);
    margin: var(--sp-space-2) 0 var(--sp-space-4);
  }
  .ldb-thumbs {
    display: flex;
    gap: var(--sp-space-3);
    overflow-x: auto;
    padding: 12px 4px 16px;
  }
  .ldb-thumb {
    all: unset;
    flex: 0 0 auto;
    cursor: zoom-in;
    border-radius: var(--sp-radius-sm);
    img {
      display: block;
      height: 140px;
      width: auto;
      border-radius: var(--sp-radius-sm);
      box-shadow:
        0 0px 15px 2px rgba(0, 0, 0, 0.2),
        0 0px 36px -18px rgba(0, 0, 0, 0.22);
    }
    &:focus-visible {
      outline: 2px solid var(--sp-color-accent);
      outline-offset: 3px;
    }
  }
</style>

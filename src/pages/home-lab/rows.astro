---
// ABOUTME: Home layout prototype D: rows. The current home's intro column, with
// ABOUTME: one project per row (photo + one line) beside it, sized to never balloon.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { NowBlock } from "../../components/Now";
import Status from "../../components/Status.astro";
import HomeLabIntro from "../../components/dev/HomeLabIntro.astro";
import HomeLabExtras from "../../components/dev/HomeLabExtras.astro";
import HomeLabSwitcher from "../../components/dev/HomeLabSwitcher.astro";
import { ProjectRows, SmallThingsFold } from "../../components/dev/HomeLab";
import { getHomeLabData } from "../../components/dev/homeLabData";
import { nowEntries } from "../../data/now-entries";

const { tending, works, small, counts } = await getHomeLabData();
const projectWorks = works.filter((c) => c.parentCategory === "Project");
---

<BaseLayout title="home layout D">
  <HomeLabSwitcher current="rows" />
  <div class="homeLab rows two-columns home-page">
    <div class="home-sidebar">
      <HomeLabIntro />
      <div class="home-now-status textContent">
        {nowEntries[0] && <NowBlock client:only="react" entry={nowEntries[0]} />}
        <HomeLabExtras counts={counts} />
        <Status />
      </div>
    </div>
    <div class="home-creations rowsColumn">
      <section>
        <h2 class="labHeading">
          what i'm tending to <span class="labHeadingNote">ongoing, and growing. tap to open</span>
        </h2>
        <ProjectRows creations={tending} size="big" client:only="react" />
      </section>
      <section>
        <h2 class="labHeading">
          selected works <span class="labHeadingNote">tap any one to open it up</span>
        </h2>
        <ProjectRows creations={projectWorks} size="medium" client:only="react" />
      </section>
      <section>
        <SmallThingsFold creations={small} client:only="react" />
        <p class="breadthLine"><a href="/creation">or see everything, talks and press included →</a></p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .rowsColumn {
    display: flex;
    flex-direction: column;
    gap: 3.5em;
  }
</style>

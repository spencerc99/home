---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Colophon"
  description="How this site & my practices have been made"
>
  <div class="one-column">
    <div class="headerContainer home textContent">
      <div class="textContent colophon">
        <header class="colophon-intro">
          <h1 class="uniform">(colophon)</h1>
          <p><i>how this site & my practices have been made.</i></p>
        </header>

        <section class="colophon-section">
          <h2>Site</h2>
          <p>
            The site is built with <a href="https://astro.build/">Astro</a>,
            React, and <a href="https://playhtml.fun/">playhtml</a>, and hosted
            on Cloudflare. The fonts are Vulf by Oh No! Type Co. and Sono by
            Tyler Finck. The background texture is a photo of the sunlight
            seeping through my jacket lining from a sunny day in Alamo Square.
          </p>
        </section>

        <section class="colophon-section">
          <h2>Inspirations</h2>
          <ul>
            <li>
              Thank you to <a href="https://robinsloan.com/">Robin Sloan</a> for
              inspiring me to add the "invited_by_Spencer_Chang" UTM source to
              all my outbound links as he does.
            </li>
          </ul>
        </section>

        <section class="colophon-section">
          <h2>People</h2>
          <p>
            a non-exhaustive, sporadically updated list of people who have
            inspired me
          </p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .colophon {
    max-width: var(--sp-measure);
    display: flex;
    flex-direction: column;
    gap: var(--sp-space-8);
  }

  .colophon p,
  .colophon h1,
  .colophon h2,
  .colophon ul {
    margin: 0;
  }

  .colophon-intro {
    display: flex;
    flex-direction: column;
    gap: var(--sp-space-3);
  }

  .colophon-section {
    display: flex;
    flex-direction: column;
    gap: var(--sp-space-3);
    line-height: var(--sp-leading-body);
  }

  .colophon-section ul {
    padding-left: var(--sp-space-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-space-3);
  }

  .colophon-section li {
    margin: 0;
    line-height: var(--sp-leading-body);
  }

</style>

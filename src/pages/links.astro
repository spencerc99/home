---
import DetailLayout from "../layouts/DetailLayout.astro";
import { LinksView } from "../components/views/Links";
import { nowEntries } from "../data/now-entries";
import { getCollection } from "astro:content";
import { hydrateCreations } from "../utils/creations";
import { formatCompactDateRange } from "../utils";

const LayoutProps = {
  title: "(domains)",
  titleClass: "uniform",
  description: "A home for my most relevant links",
  emojis: [],
  columns: 1,
};

const currentNowEntry = nowEntries[0];

// Get latest post from local content collection
const posts = ((await getCollection("posts")) || [])
  .filter((post) => !post.data.hidden && !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPost = posts[0];
const latestNewsletter = {
  title: latestPost?.data.title || "Latest newsletter",
  url: latestPost?.data.externalLink || `/posts/${latestPost?.id}`,
};

// Upcoming events (mirrors the home page's forthcoming events)
const upcomingEvents = hydrateCreations(await getCollection("creation"))
  .filter((c) => c.data.isEvent && c.data.forthcoming)
  .sort(
    (a, b) =>
      new Date(a.data.date || 0).getTime() -
      new Date(b.data.date || 0).getTime(),
  )
  .map((c) => ({
    title: c.data.title,
    url: c.data.link,
    location: c.data.location,
    parentCategory: c.data.parentCategory,
    dateRange:
      c.data.date &&
      formatCompactDateRange(
        new Date(c.data.date),
        c.data.endDate ? new Date(c.data.endDate) : null,
      ),
  }));
---

<DetailLayout {...LayoutProps}>
  <LinksView
    client:only="react"
    nowEntry={currentNowEntry}
    latestNewsletter={latestNewsletter}
    upcomingEvents={upcomingEvents}
  />
</DetailLayout>
